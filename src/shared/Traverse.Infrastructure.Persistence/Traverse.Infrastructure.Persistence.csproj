<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Traverse.Infrastructure.Persistence</RootNamespace>
    <AssemblyName>Traverse.Infrastructure.Persistence</AssemblyName>
    <Description>Shared EF Core persistence scaffolding (TraverseDbContext base, audit logging, value converters, post-commit domain event dispatch) for Traverse services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Traverse.Domain.Primitives\Traverse.Domain.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9.* is the latest stable supporting net10.0 at implementation time. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.*" />

    <!-- Npgsql provider must match the EF Core major version. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />

    <!-- DI plumbing aligned with the rest of the platform on net10.0. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />

    <!-- MediatR provides IPublisher used for post-commit domain event dispatch.
         A direct reference is required because TraverseDbContext signature
         depends on the IPublisher interface. The interface itself pulls no
         ASP.NET Core dependencies (verified). -->
    <PackageReference Include="MediatR" Version="12.*" />
  </ItemGroup>

</Project>
