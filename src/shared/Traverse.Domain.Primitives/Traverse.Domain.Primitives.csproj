<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Traverse.Domain.Primitives</RootNamespace>
    <AssemblyName>Traverse.Domain.Primitives</AssemblyName>
    <Description>Core domain primitives (aggregate roots, entities, value objects, strongly-typed IDs, domain events, results, and exceptions) for the Traverse platform. Zero NuGet and zero project dependencies — strict DIP foundation.</Description>
  </PropertyGroup>

</Project>
