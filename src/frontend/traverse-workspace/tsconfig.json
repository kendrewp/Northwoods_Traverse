  "_stub_notice": "NT-001 stub — merge into ng new output in NT-003. Do not overwrite; merge path aliases and compiler options.",
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
