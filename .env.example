# .env.example -- Northwoods Traverse Local Development Environment
#
# Copy this file to .env before running `docker compose up`.
# The .env file is gitignored; only this .env.example is committed.
#
# These values are non-sensitive local development defaults.
# NEVER reuse these credentials in any non-local environment.
# Production credentials are managed via Azure Key Vault / AWS Secrets Manager
# (see .NET Coding Standards section 15 and docs/NT-000/NT-004/design_local_dev_env.md section 4.9).
#
# All ports are overridable here -- if any default conflicts with a service
# already running on your machine, change the value in your local .env.

# PostgreSQL
# Admin user for all service databases (database-per-service pattern, see docker/postgres/init.sql)
POSTGRES_USER=traverse
POSTGRES_PASSWORD=traverse_dev
POSTGRES_PORT=5432

# RabbitMQ
# Default vhost is "/" -- MassTransit uses this vhost from Traverse.Infrastructure.Messaging
RABBITMQ_USER=traverse
RABBITMQ_PASSWORD=traverse_dev
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# n8n (workflow automation engine)
# N8N_BASIC_AUTH_ACTIVE is set to false in docker-compose.yml -- local dev only, no auth required
N8N_PORT=5678

# Service API stub ports (5001-5009)
# Override only when a port conflicts with another local service.
# Example: add POSTGRES_PORT=5433 to your .env if port 5432 is already in use.
WORKFLOW_PORT=5001
KPI_PORT=5002
ADMIN_PORT=5003
NOTIFICATIONS_PORT=5004
REPORTING_PORT=5005
AICOPILOT_PORT=5006
COMPLIANCE_PORT=5007
SEARCH_PORT=5008
CALENDAR_PORT=5009
